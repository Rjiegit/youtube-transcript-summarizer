OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=900
# Processing orchestration: legacy|langgraph. Keep legacy during rollout.
PROCESSING_ENGINE=legacy
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Base URL for Notion workspace (用於組合 UI 列表的 Notion 連結，例如 https://www.notion.so/your-workspace)
NOTION_URL=
SHOWCASE_CACHE_TTL_SECONDS=3600
DISCORD_WEBHOOK_URL=
# 知識庫根網址（可選）；設定後 Discord 完成通知會附上摘要詳細頁連結。
# 例如 https://knowledge.example.com，不要包含 /results。
SHOWCASE_BASE_URL=
PROCESSING_LOCK_ADMIN_TOKEN=example-maintainer-token
PROCESSING_WORKER_TOKEN=
PROCESSING_WORKER_POLL_INTERVAL_SECONDS=60
TASK_LOCK_TIMEOUT_SECONDS=900
TASK_LEASE_HEARTBEAT_SECONDS=30
# Seconds to cache a completed task result for the same URL (default: 3600)
TASK_CACHE_TTL_SECONDS=3600
RSS_MONITOR_ENABLED=true
RSS_MONITOR_POLL_INTERVAL_SECONDS=3600
RSS_MONITOR_MIN_POLL_INTERVAL_SECONDS=300
RSS_MONITOR_TASK_TIMEOUT_SECONDS=15
TASK_API_BASE_URL=http://localhost:8080
