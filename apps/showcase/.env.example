NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_STATUS_PROPERTY=
NOTION_COMPLETED_STATUS=Completed
# 展示頁 CDN / server cache TTL，單位秒；預設 3600
SHOWCASE_CACHE_TTL_SECONDS=3600

# Optional: cross-device read-state sync through Upstash Redis.
# Legacy personal-code sync; only used when SHOWCASE_ACCOUNT_AUTH_ENABLED=false.
# Account mode enables its own read sync automatically with the Upstash URL/token.
READ_STATE_SYNC_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Personal code entered in the UI when a device enables sync.
READ_STATE_SYNC_ACCESS_TOKEN=
# Separate random secret used only to sign the HttpOnly session cookie.
READ_STATE_SYNC_SESSION_SECRET=
# Stable namespace for the current personal data. Keep this unchanged when rotating secrets.
READ_STATE_SYNC_SPACE_ID=personal
# Per-entry read-state retention in seconds; default is 30 days after each status update.
READ_STATE_SYNC_TTL_SECONDS=2592000

# 若部署平台偏好使用 Nuxt runtime 覆寫，也可改用這組鍵名：
# NUXT_NOTION_API_KEY=
# NUXT_NOTION_DATABASE_ID=
# NUXT_NOTION_STATUS_PROPERTY=
# NUXT_NOTION_COMPLETED_STATUS=Completed
# NUXT_SHOWCASE_CACHE_TTL_SECONDS=3600

# Protected video inbox: server-only, independent of read-state sync/Redis.
VIDEO_INBOX_ACCESS_TOKEN=
VIDEO_INBOX_ORIGIN=http://localhost:3000
VIDEO_INBOX_SUPABASE_URL=
VIDEO_INBOX_PUBLISHABLE_KEY=
# Random 256-bit submit token; store only its SHA-256 hash in Supabase.
VIDEO_INBOX_SUBMIT_TOKEN=

# One switch for invited sign-in, account-only submissions and per-account read sync.
# Defaults to false; changing it requires redeploy. Keep the server-only inbox submit token.
SHOWCASE_ACCOUNT_AUTH_ENABLED=false
# Supabase Auth project URL and publishable key. The publishable key is browser-visible.
SHOWCASE_SUPABASE_URL=
SHOWCASE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase auth.users IDs allowed to use account features. Server-only.
SHOWCASE_ALLOWED_USER_IDS=
