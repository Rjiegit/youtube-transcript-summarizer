NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_STATUS_PROPERTY=
NOTION_COMPLETED_STATUS=Completed
# 展示頁 CDN / server cache TTL，單位秒；預設 3600
SHOWCASE_CACHE_TTL_SECONDS=3600

# Optional: cross-device read-state sync through Upstash Redis.
# Keep disabled to preserve the original localStorage-only behavior.
READ_STATE_SYNC_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Personal code entered in the UI when a device enables sync.
READ_STATE_SYNC_ACCESS_TOKEN=
# Separate random secret used only to sign the HttpOnly session cookie.
READ_STATE_SYNC_SESSION_SECRET=
# Stable namespace for the current personal data. Keep this unchanged when rotating secrets.
READ_STATE_SYNC_SPACE_ID=personal

# 若部署平台偏好使用 Nuxt runtime 覆寫，也可改用這組鍵名：
# NUXT_NOTION_API_KEY=
# NUXT_NOTION_DATABASE_ID=
# NUXT_NOTION_STATUS_PROPERTY=
# NUXT_NOTION_COMPLETED_STATUS=Completed
# NUXT_SHOWCASE_CACHE_TTL_SECONDS=3600
